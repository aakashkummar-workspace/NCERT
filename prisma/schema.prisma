// NCERT Quick — server data tier (Phases 0–4).
//
// This schema stores the one thing the client-side Dexie stores cannot: a mark
// awarded by someone other than the student. Everything here exists to make a
// photographed handwritten answer gradable, reviewable by a human, and
// explainable back to the student — see prisma/README.md for why each
// non-obvious shape is the shape it is.
//
// Tenancy, parents, rosters, wallets and payouts are deliberately absent.
// `scopeId` on `User` is the seam they retrofit through; nothing else here
// anticipates them.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  /// The same database, reached without the connection pooler.
  ///
  /// Every managed Postgres this would deploy on — Neon, Supabase, Vercel
  /// Postgres — sits behind PgBouncer in transaction mode. That is right for
  /// the app (a serverless function opens a connection per invocation and the
  /// pooler is what stops that exhausting the database) and wrong for
  /// migrations, which need session-level state: advisory locks to serialise
  /// concurrent deploys, and `CREATE TYPE`/`ALTER TABLE` inside one long-lived
  /// session. Run `prisma migrate deploy` through the pooler and it fails
  /// somewhere in the middle with a lock or prepared-statement error that names
  /// neither.
  ///
  /// So: DATABASE_URL is the pooled URL and is what the app uses; DIRECT_URL is
  /// the direct one, port 5432, and is used only by migrate and introspect.
  /// Locally they are the same string — see .env.example — and that is fine.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  EVALUATOR
  ADMIN
  /// A parent sees a child's trend, never their doubts. The link itself is a
  /// separate consented edge, not a role — the role only says what this person
  /// is; ParentLink says whose.
  PARENT
}

enum EvaluatorType {
  SCHOOL_TEACHER
  INTERNAL_TUTOR
  FREELANCE
}

/// Mirrors `QuestionType` in src/lib/papers.ts and the `type` field in
/// data/papers.json. The mapped values are byte-identical to the JSON, so a
/// paper's section table can be loaded without a translation step.
enum QuestionType {
  MCQ              @map("mcq")
  ASSERTION_REASON @map("assertion-reason")
  VSA              @map("vsa")
  SA               @map("sa")
  LA               @map("la")
  CASE_STUDY       @map("case-study")
}

/// Mirrors `AttemptStatus` in src/lib/attempts.ts.
enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

/// The life of an uploaded answer sheet. AWAITING_REVIEW and UNDER_REVIEW only
/// occur when the submission was routed to a human.
enum SubmissionStatus {
  UPLOADING
  QUEUED
  OCR_RUNNING
  AI_GRADING
  AWAITING_REVIEW
  UNDER_REVIEW
  GRADED
  FAILED
}

enum OcrStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum RubricSource {
  /// Transcribed from the official CBSE marking scheme PDF.
  CBSE_MARKING_SCHEME
  /// Hand-authored, the way data/questions.json is.
  AUTHORED
  /// Generated by a model. Never used to override a human without review.
  AI_GENERATED
}

/// The three step kinds in data/rubrics.schema.md, plus `OPTION` for the
/// children of a `choose` group — which the JSON nests rather than naming.
/// Mapped values are byte-identical to data/rubrics.json.
enum CriterionKind {
  STEP    @map("step")
  CHOOSE  @map("choose")
  DIAGRAM @map("diagram")
  OPTION  @map("option")

  /// CBSE's OR *inside* a question, where `variant` cannot reach because the
  /// rest of the question is common to both branches. The group contributes
  /// its marks ONCE; every BRANCH child must sum to that same figure, or a
  /// student is graded out of a different total depending which they chose.
  ALTERNATIVES @map("alternatives")
  /// One branch of an ALTERNATIVES group. Its own children are ordinary
  /// STEP / CHOOSE / DIAGRAM criteria.
  BRANCH       @map("branch")
}

/// Whether a rubric's steps must be answered in order. `ordering` on the rubric
/// is the default; `ordered` on a step overrides it.
enum RubricOrdering {
  ORDERED   @map("ordered")
  UNORDERED @map("unordered")
}

/// Whether a step needs every one of its concepts or only one of them.
/// `match` in data/rubrics.schema.md; the default is `all`.
enum MatchMode {
  ALL @map("all")
  ANY @map("any")
}

/// The closed list of reasons a step may be partially credited. Closed on
/// purpose: "orange" has to mean something a student can act on, and a free-text
/// reason would drift into a synonym per author.
enum PartialReason {
  UNIT_MISSING     @map("unit-missing")
  UNIT_WRONG       @map("unit-wrong")
  ORDER_BROKEN     @map("order-broken")
  KEYWORDS_PARTIAL @map("keywords-partial")
  ARITHMETIC_SLIP  @map("arithmetic-slip")
  FORMULA_ONLY     @map("formula-only")
  SIGN_ERROR       @map("sign-error")
  UNROUNDED        @map("unrounded")
}

/// Who produced a grade. This is durable evidence, not a workflow flag: a
/// student is entitled to see that a human changed the machine's mark.
enum GradeSource {
  AI
  HUMAN
}

/// Per-criterion verdict — the outcome table in data/rubrics.schema.md. It
/// drives, but is not the same thing as, a highlight colour: one MISS can paint
/// several separate red spans, and UNMARKED paints nothing at all.
enum CriterionVerdict {
  HIT
  PARTIAL
  MISS
  /// Not graded. Contributes nothing to the total, and must never be shown to a
  /// student as a wrong answer — that is the whole point of it existing.
  UNMARKED
}

/// Why a criterion came back UNMARKED. Both cases are refusals to guess, and a
/// teacher needs to tell them apart: one is waiting on a human eye, the other is
/// waiting on a human signature.
enum UnmarkedReason {
  /// `autoGradable: false` — a diagram step. A keyword matcher run over a
  /// photograph cannot honestly say whether a triangle was drawn correctly.
  NOT_AUTO_GRADABLE
  /// A miss withheld because the rubric is flagged `needsReview`. Signing the
  /// rubric off and re-grading is what turns these into honest reds.
  RUBRIC_NEEDS_REVIEW
}

/// The PRD's three scannable highlights over the student's own handwriting.
/// There is deliberately no fourth member for the UNMARKED outcome: see the
/// note on `HighlightSpan`.
enum HighlightColor {
  GREEN
  ORANGE
  RED
}

enum TicketStatus {
  PENDING
  CLAIMED
  IN_REVIEW
  COMPLETED
  EXPIRED
  CANCELLED
}

enum TranscriptStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Phone-first. A Class 9 student in India routinely has no email address and
/// no intention of getting one, so `phone` is the identifier and `email` is an
/// optional convenience.
///
/// Neither is globally unique. Both are unique *within a scope*, because a
/// global unique on phone breaks the first B2B roster import that contains two
/// siblings sharing a parent's number across two schools, and makes tenancy a
/// destructive migration later. `scopeId` is a real UUID column today, with
/// every row on the nil-UUID "public" scope. See prisma/README.md.
model User {
  id      String  @id @default(uuid()) @db.Uuid
  /// The nil UUID = the public (B2C) scope. Becomes `tenant_id` when tenancy lands.
  scopeId String  @default("00000000-0000-0000-0000-000000000000") @db.Uuid
  /// E.164, e.g. "+919876543210". Normalise before writing; the database will not.
  ///
  /// Nullable only because email + password sign-in exists, and an account
  /// created that way has no number. The original reasoning for NOT NULL still
  /// holds and is *not* abandoned: Postgres treats NULLs as distinct, so a
  /// nullable identifier under a plain unique index permits unlimited rows
  /// with no identifier at all. What replaces NOT NULL is the CHECK
  /// `user_has_identifier` (see the migration) — a user must carry a phone, an
  /// email, or both, and whichever they carry is still unique per scope.
  phone   String? @db.VarChar(20)
  /// NULL for most students. Postgres treats NULLs as distinct, so the scoped
  /// unique below permits any number of email-less users.
  email   String? @db.VarChar(255)
  /// scrypt, self-describing: `scrypt$N$r$p$dkLen$salt$hash`, both parts
  /// base64url. NULL for an OTP-only or seeded account that has never set one —
  /// having no password is legal, and is not the same as having a wrong one.
  /// See src/lib/auth.ts; the parameters live in the string so they can be
  /// raised later without guessing what an old row was hashed with.
  passwordHash String? @db.VarChar(255)

  displayName String?  @db.VarChar(120)
  role        UserRole
  /// Whether this student's submissions may be routed to a human evaluator.
  hitlEnabled Boolean  @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  studentProfile   StudentProfile?
  evaluatorProfile EvaluatorProfile?

  attempts        Attempt[]
  submissions     Submission[]
  gradesGiven     GradingResult[]    @relation("GradeEvaluator")
  reviews         EvaluatorReview[]
  voiceNotes      VoiceNote[]
  ticketsClaimed  EvaluationTicket[] @relation("TicketClaimedBy")
  ticketsAssigned EvaluationTicket[] @relation("TicketAssignedTo")

  @@unique([scopeId, phone])
  @@unique([scopeId, email])
  @@index([scopeId, role])
  @@map("users")
}

/// Class-level facts that only students have. Kept off `users` so an evaluator
/// row does not carry a nullable `class_num` that nothing may read.
model StudentProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 9 or 10. Not an enum: the app already carries `9 | 10` as a number
  /// everywhere (src/lib/papers.ts, src/lib/revision.ts), and adding Class 11
  /// should be a data change, not a schema migration.
  classNum   Int
  schoolName String? @db.VarChar(200)
  /// BCP-47, e.g. "en" or "hi" — the reader ships Hindi books.
  language   String  @default("en") @db.VarChar(16)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([classNum])
  @@map("student_profiles")
}

model EvaluatorProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  evaluatorType EvaluatorType
  /// Cleared to take an evaluator off the queue without deleting their history.
  activeForRouting Boolean @default(true)
  /// How many open tickets this evaluator may hold at once.
  maxConcurrent    Int     @default(5)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  subjects EvaluatorSubject[]

  @@index([activeForRouting, evaluatorType])
  @@map("evaluator_profiles")
}

/// What an evaluator is qualified to mark. One row per (subject, class) rather
/// than a `subjects` lookup table: subject and class are build-time constants of
/// data/manifest.json and data/papers.json, and a second copy of them in
/// Postgres would only ever drift away from the files that generate the routes.
model EvaluatorSubject {
  id                 String           @id @default(uuid()) @db.Uuid
  evaluatorProfileId String           @db.Uuid
  evaluatorProfile   EvaluatorProfile @relation(fields: [evaluatorProfileId], references: [id], onDelete: Cascade)

  /// "Science", "Mathematics", … — matches `Paper.subject`.
  subject  String @db.VarChar(60)
  classNum Int

  @@unique([evaluatorProfileId, subject, classNum])
  @@index([subject, classNum])
  @@map("evaluator_subjects")
}

// ---------------------------------------------------------------------------
// Attempts — the server mirror of src/lib/attempts.ts
// ---------------------------------------------------------------------------

/// A timed run at a paper. The client owns this record first (IndexedDB,
/// offline) and syncs it up. `clientAttemptId` is Dexie's
/// `${paperSlug}:${startedAt}` key, so a retried sync updates the same row
/// rather than forking the attempt into two.
///
/// `startedAt` is a real timestamp here even though the client keeps a
/// wall-clock number, because the client's clock is the timer's source of truth
/// and the server's copy is only ever a record of it.
model Attempt {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Dexie primary key from src/lib/attempts.ts. Unique per student, not global.
  clientAttemptId String @db.VarChar(120)

  paperSlug String @db.VarChar(120)
  subject   String @db.VarChar(60)
  classNum  Int
  maxMarks  Int

  startedAt   DateTime      @db.Timestamptz(6)
  durationMs  Int
  submittedAt DateTime?     @db.Timestamptz(6)
  status      AttemptStatus @default(IN_PROGRESS)

  /// Sum of the per-question marks, written when scoring is finalised.
  /// Denormalised on purpose: every history row shows it and nothing else on
  /// that screen needs the per-question join.
  totalScore Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  questions   AttemptQuestion[]
  submissions Submission[]

  @@unique([studentId, clientAttemptId])
  @@index([studentId, startedAt(sort: Desc)])
  @@index([studentId, status])
  @@index([paperSlug])
  @@map("attempts")
}

/// One row per question in the paper's mark grid — the expansion of
/// `Paper.sections` that `questionsFor()` performs client-side.
///
/// It carries both marks: `selfScore`, what the student awarded themselves
/// against the marking scheme, and `awardedMarks`, copied down from the current
/// `GradingResult` when the answer was photographed and graded. The self-marked
/// and graded paths converge on this row, and either can feed the SM-2 card.
model AttemptQuestion {
  id        String  @id @default(uuid()) @db.Uuid
  attemptId String  @db.Uuid
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionNumber Int
  maxMarks       Int
  type           QuestionType
  sectionLabel   String?      @db.VarChar(8)
  topic          String?      @db.VarChar(60)

  /// The student's own mark. NULL until scored, or when the question was skipped.
  selfScore Decimal? @db.Decimal(5, 2)
  /// False when the student left the question blank in the exam.
  attempted Boolean  @default(true)

  /// Mark from the current (non-superseded) grading result, denormalised so a
  /// results screen is one query. Recomputed whenever a grade is appended;
  /// `GradingResult` stays the authority.
  awardedMarks Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  answers Answer[]

  @@unique([attemptId, questionNumber])
  @@map("attempt_questions")
}

// ---------------------------------------------------------------------------
// Submissions — photographed answer sheets
// ---------------------------------------------------------------------------

/// A set of photographs of one student's handwritten answers.
///
/// `idempotencyKey` is generated by the client before the first byte is
/// uploaded. Indian mobile networks drop and retry POSTs freely, and a student
/// who ends up with two copies of the same answer sheet is charged twice and
/// shown two contradictory grades. The unique below turns the retry into a
/// no-op.
model Submission {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// NULL when the student photographed an answer outside a timed paper run.
  attemptId String?  @db.Uuid
  attempt   Attempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  paperSlug String? @db.VarChar(120)
  subject   String  @db.VarChar(60)
  classNum  Int

  /// Client-generated, unique per student. See the note above.
  idempotencyKey String @db.VarChar(64)

  status    SubmissionStatus @default(UPLOADING)
  pageCount Int              @default(0)
  /// Why the pipeline gave up, for the retry screen. NULL unless FAILED.
  failureReason String?

  /// When the photographs were taken, by the phone's clock. May precede
  /// `createdAt` by hours if the upload waited for a network.
  capturedAt DateTime? @db.Timestamptz(6)
  gradedAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  pages   SubmissionPage[]
  answers Answer[]
  ticket  EvaluationTicket?

  @@unique([studentId, idempotencyKey])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([attemptId])
  @@map("submissions")
}

/// One photograph. `storageKey` is an object key, never a URL: pre-signed URLs
/// expire, so a stored one is a dead link by the next day.
model SubmissionPage {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  pageIndex   Int
  storageKey  String  @db.VarChar(512)
  contentType String  @db.VarChar(64)
  bytes       Int?
  widthPx     Int?
  heightPx    Int?
  sha256      String? @db.Char(64)

  ocrStatus OcrStatus @default(PENDING)
  /// Full-page OCR text. Per-answer text lives on `Answer.transcript`, because
  /// one answer can run across two pages and one page can hold three answers.
  ocrText        String?
  ocrCompletedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  answerPages    AnswerPage[]
  highlightSpans HighlightSpan[]

  @@unique([submissionId, pageIndex])
  @@index([ocrStatus, createdAt])
  @@map("submission_pages")
}

/// One question's worth of handwriting — the unit everything downstream grades,
/// highlights and talks over.
model Answer {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Set when the submission belongs to a known paper attempt; NULL for a loose
  /// photo of an answer we cannot place in a mark grid.
  attemptQuestionId String?          @db.Uuid
  attemptQuestion   AttemptQuestion? @relation(fields: [attemptQuestionId], references: [id], onDelete: SetNull)

  questionNumber Int
  maxMarks       Decimal      @db.Decimal(5, 2)
  type           QuestionType

  /// The student's writing as OCR read it. Highlight spans index into this.
  transcript String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  pages          AnswerPage[]
  gradingResults GradingResult[]
  voiceNotes     VoiceNote[]

  @@unique([submissionId, questionNumber])
  @@index([attemptQuestionId])
  @@map("answers")
}

/// Which pages an answer occupies, in reading order. A genuine many-to-many:
/// question 31 spills onto the next sheet, and that sheet also starts 32.
model AnswerPage {
  answerId String @db.Uuid
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  submissionPageId String         @db.Uuid
  submissionPage   SubmissionPage @relation(fields: [submissionPageId], references: [id], onDelete: Cascade)

  /// 0-based position of this page within the answer.
  ordinal Int

  @@id([answerId, submissionPageId])
  @@index([submissionPageId])
  @@map("answer_pages")
}

// ---------------------------------------------------------------------------
// Rubrics
// ---------------------------------------------------------------------------

/// The marking scheme for one question, versioned. Rubrics get corrected, and a
/// grade must stay attached to the rubric it was actually given under — so a
/// correction is a new version, not an edit.
///
/// The field names track `data/rubrics.json` (contract: `data/rubrics.schema.md`),
/// which is hand-converted from the official marking-scheme PDFs. That file is
/// the authoring format; this table is where a loaded copy lives so a grade can
/// hold a foreign key to the exact rubric version it was given under.
model Rubric {
  id String @id @default(uuid()) @db.Uuid
  /// The authored `id` from data/rubrics.json, e.g. "class10-science-2025-26-q10".
  /// Unique together with `version` so a re-import is idempotent.
  externalId String? @db.VarChar(160)

  /// `paper` in the JSON — a slug in data/papers.json. Required: `rubric:check`
  /// rejects a rubric whose paper it cannot find, so there is no such thing here
  /// as a rubric without one. Spelled `paperSlug` to match `Attempt` and
  /// `Submission`; the contract tolerates that spelling.
  paperSlug      String  @db.VarChar(120)
  questionNumber Int
  /// CBSE's internal choice: "attempt either option A or B". Each option is its
  /// own rubric, same `questionNumber`, different `variant`, each summing to
  /// `maxMarks` on its own.
  ///
  /// Empty string, not NULL, for a question that offers no choice. Postgres
  /// treats NULLs as distinct, so a nullable `variant` would let two rubrics for
  /// the same un-varianted question sit side by side — exactly the duplicate
  /// `rubric:check` rejects. A sentinel keeps the unique below real.
  variant  String       @default("") @db.VarChar(16)
  session  String?      @db.VarChar(16)
  type     QuestionType
  maxMarks Decimal      @db.Decimal(5, 2)
  version  Int          @default(1)
  source   RubricSource

  /// The load-bearing pair, exactly as in questions.json: what ties a graded
  /// answer back to a chapter, and so into /revise and /progress. Required —
  /// a rubric with no chapter has nowhere to send the result.
  bookCode String @db.VarChar(16)
  chapter  Int

  /// Advisory only. The manifest already knows `jesc1` is Class 10 Science, and
  /// the book decides; these are denormalised for routing and for indexes. A
  /// rubric whose stated class the manifest contradicts is rejected at import,
  /// so a disagreement never reaches this table.
  subject  String @db.VarChar(60)
  classNum Int

  /// The stem, abbreviated. For the reviewer and the grading canvas, not for the
  /// matcher.
  prompt String?

  ordering RubricOrdering @default(UNORDERED)
  /// CBSE's own "or equivalent wording" licence. False where the answer *is* a
  /// specific term or number — "Anthracite", "25 km/hr" — and a near-miss should
  /// not be green.
  acceptEquivalentWording Boolean @default(true)

  /// **Gates grading, not just review.** Nothing is ever painted red on a rubric
  /// flagged `needsReview`: an unchecked conversion may accuse a student of
  /// writing nothing of value, which is the one mistake with no recovery. Such a
  /// rubric may award green and orange; a miss comes back UNMARKED with
  /// `RUBRIC_NEEDS_REVIEW` until a teacher signs it off.
  ///
  /// This is the common case, not an edge case — most seeded rubrics carry it.
  needsReview Boolean  @default(false)
  /// What the reviewer has to decide, one note per open question.
  reviewNotes String[]

  /// Provenance: which marking-scheme PDF, and which page of it.
  schemeFile String? @db.VarChar(160)
  schemePage Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  criteria RubricCriterion[]
  results  GradingResult[]

  @@unique([externalId, version])
  // The identity `rubric:check` enforces, plus our own versioning. Subject and
  // class are deliberately absent: they are advisory, and the book decides.
  @@unique([paperSlug, questionNumber, variant, version])
  @@index([paperSlug, questionNumber])
  @@index([bookCode, chapter])
  @@index([subject, classNum])
  @@index([needsReview])
  @@map("rubrics")
}

/// One line of the marking scheme: "states Ohm's law — half a mark".
///
/// It is a tree, not a list, because CBSE writes "any two of the following". A
/// `CHOOSE` group holds `chooseAtLeast` and its `OPTION` children hold the
/// alternatives. Flattening that into a list loses the constraint that makes it
/// gradable — three options each worth a mark on a 2-mark question is not the
/// same rubric.
model RubricCriterion {
  id       String @id @default(uuid()) @db.Uuid
  rubricId String @db.Uuid
  rubric   Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  /// The authored step id from data/rubrics.json — "s1", "g1", "o1". Stable
  /// across re-imports, which is what makes the unique below meaningful.
  stepId String @db.VarChar(40)

  /// An `OPTION` hangs under its `CHOOSE` group, a `BRANCH` under its
  /// `ALTERNATIVES` group, and a branch's own steps under that `BRANCH`; every
  /// other kind is top level.
  parentId String?           @db.Uuid
  parent   RubricCriterion?  @relation("CriterionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children RubricCriterion[] @relation("CriterionTree")

  ordinal Int
  kind    CriterionKind @default(STEP)
  /// `awardFor` in the JSON: what the mark is given for, as the scheme phrases
  /// it. Named for the contract rather than as a generic `label`, because a
  /// reviewer reads this column against the PDF.
  awardFor String @db.VarChar(300)
  /// The label the paper prints for a `BRANCH` — CBSE's "A" / "B". Null on
  /// every other kind. Kept separate from `awardFor` because a student picks a
  /// branch by its printed letter, not by what it awards.
  branchLabel String? @db.VarChar(16)

  /// What a `STEP` or `DIAGRAM` is worth. NULL on a `CHOOSE` group and on an
  /// `OPTION`.
  marks Decimal? @db.Decimal(5, 2)
  /// What *each* satisfied option of a `CHOOSE` group is worth. NULL on
  /// everything else.
  ///
  /// Two columns rather than one, because the group's contribution to `maxMarks`
  /// is `chooseAtLeast × marksEach`, not `marksEach`. Conflating them under one
  /// name makes `SUM(marks)` over a rubric's top-level steps quietly wrong — and
  /// "the steps must sum to maxMarks" is the contract's most damaging error to
  /// get wrong, because it grades every attempt out of the wrong denominator.
  marksEach Decimal? @db.Decimal(5, 2)
  /// `CHOOSE` only: how many options must be present to score the group.
  chooseAtLeast Int?

  /// Must every concept appear, or only one? `match` in the JSON. `ANY` is the
  /// right setting for a free-recall step where the scheme only wants the idea.
  match MatchMode @default(ALL)

  /// `unit.required` / `unit.accepted`. A mandatory unit is what makes
  /// `UNIT_MISSING` partial credit meaningful.
  unitRequired Boolean  @default(false)
  unitAccepted String[]

  /// `OPTION` only: the tags a `requireTags` demand on the parent group counts.
  tags String[]

  /// `DIAGRAM` only: what the figure must show. For the human reviewing the
  /// page, not for the matcher.
  labels String[]

  /// False means no matcher may decide this step — it resolves to UNMARKED and
  /// waits for a person. Forced false on a `DIAGRAM`: a keyword matcher run over
  /// a photograph cannot honestly say whether a triangle was drawn correctly.
  autoGradable Boolean @default(true)

  /// Must follow the steps before it; overrides the rubric's `ordering`. NULL
  /// means "inherit". Always NULL on an `OPTION` — options are order-free.
  ordered Boolean?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  concepts     RubricConcept[]
  partialRules PartialCreditRule[]
  tagDemands   RubricTagRequirement[]
  results      CriterionResult[]

  @@unique([rubricId, stepId])
  @@index([parentId])
  @@index([rubricId, ordinal])
  @@map("rubric_criteria")
}

/// One concept a step is looking for, and every phrasing that satisfies it.
///
/// The contract is explicit that `keywords` is a list of **concepts**, not a
/// list of strings: `[{ any: ["4 ohm", "4 Ω", "4Ω"] }, { any: ["stomata"] }]`
/// means *one of the first set* AND *one of the second*. A flat `String[]` of
/// all six phrasings cannot express that — it collapses the AND between concepts
/// into a bag, and a step needing two distinct ideas would score on one of them
/// written two ways.
///
/// This is also where "or equivalent wording" lives: per concept, rather than as
/// a blanket over the step.
model RubricConcept {
  id                String          @id @default(uuid()) @db.Uuid
  rubricCriterionId String          @db.Uuid
  rubricCriterion   RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)

  ordinal Int
  /// The `any` array: accepted phrasings, one of which satisfies this concept.
  /// Never empty — `rubric:check` rejects a concept with an empty `any`.
  phrasings String[]

  @@unique([rubricCriterionId, ordinal])
  @@map("rubric_concepts")
}

/// A named way for a step to be partly right, and what that is worth — the only
/// thing that makes orange possible.
///
/// `award` must be a positive multiple of 0.5 and strictly less than the step's
/// `marks`, which means a half-mark step cannot be partially credited at all:
/// it is green or it is red. A `partial` on a 0.5-mark step is an authoring
/// error, not a rounding problem to solve at grading time.
model PartialCreditRule {
  id                String          @id @default(uuid()) @db.Uuid
  rubricCriterionId String          @db.Uuid
  rubricCriterion   RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)

  reason PartialReason
  award  Decimal       @db.Decimal(5, 2)
  /// Shown to the student under the orange span: "value right, unit absent".
  note   String?       @db.VarChar(300)

  results CriterionResult[]

  /// One rule per reason per step — two different awards for `unit-missing`
  /// would be a coin toss at grading time.
  @@unique([rubricCriterionId, reason])
  @@map("partial_credit_rules")
}

/// `requireTags` — the awkward second half of CBSE's "any two of the following".
///
/// The Social Science scheme does not stop at a count: Q16 wants "at least one
/// related to climate and one economic", Q38B "ANY 5 points, at least 2 positive
/// and 2 negative". Each row is one tag and the minimum number of *scoring*
/// options that must carry it. A group that meets `chooseAtLeast` but not these
/// is not full marks.
///
/// A table rather than a JSON map on the group, so that the grader joins against
/// `RubricCriterion.tags` instead of parsing, and so `rubric:check`'s "a
/// requireTags demand no set of scoring options could satisfy" is a query.
model RubricTagRequirement {
  id                String          @id @default(uuid()) @db.Uuid
  rubricCriterionId String          @db.Uuid
  rubricCriterion   RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)

  tag      String @db.VarChar(40)
  minCount Int

  @@unique([rubricCriterionId, tag])
  @@map("rubric_tag_requirements")
}

// ---------------------------------------------------------------------------
// Grading — append-only
// ---------------------------------------------------------------------------

/// One verdict on one answer. Never updated in place.
///
/// The AI's grade is evidence, and so is the fact that a human disagreed with
/// it. A human override is a new row with `revision = previous + 1` and
/// `supersedesId` pointing at what it replaced, which is what lets a student be
/// shown "AI: 3/5 → your teacher: 4/5" rather than a mark that silently
/// changed. The current grade is the row in the chain that nothing supersedes;
/// equivalently, the highest `revision` for the answer.
///
/// There is deliberately no `updatedAt`.
model GradingResult {
  id       String @id @default(uuid()) @db.Uuid
  answerId String @db.Uuid
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  /// The rubric version this verdict was given under.
  rubricId String? @db.Uuid
  rubric   Rubric? @relation(fields: [rubricId], references: [id], onDelete: Restrict)

  source GradeSource
  /// 1 for the first verdict on an answer, then 2, 3, … Each override appends.
  revision Int

  /// The row this one replaces. The unique keeps the chain linear: two people
  /// cannot both override the same version and leave two "current" grades.
  supersedesId String?        @unique @db.Uuid
  supersedes   GradingResult? @relation("Supersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy GradingResult? @relation("Supersedes")

  awardedMarks Decimal @db.Decimal(5, 2)
  maxMarks     Decimal @db.Decimal(5, 2)

  /// How many criteria came back UNMARKED. Non-zero means this grade is
  /// provisional and must be presented as such — some of the paper has not been
  /// judged, and the difference between "out of 5 you scored 3" and "of the 4
  /// marks anyone has checked, you scored 3" is the difference between an honest
  /// number and a false one. It is also the routing signal: a submission with
  /// unmarked criteria is the one that most needs a human.
  unmarkedCount Int @default(0)

  /// AI only: 0–1 self-reported confidence, and what produced the verdict.
  confidence   Float?
  modelName    String? @db.VarChar(80)
  modelVersion String? @db.VarChar(40)

  /// HUMAN only.
  evaluatorId String?          @db.Uuid
  evaluator   User?            @relation("GradeEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)
  reviewId    String?          @db.Uuid
  review      EvaluatorReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  /// Written feedback shown under the marks.
  comment String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  criterionResults CriterionResult[]
  highlights       HighlightSpan[]

  @@unique([answerId, revision])
  @@index([answerId, createdAt(sort: Desc)])
  @@index([evaluatorId, createdAt(sort: Desc)])
  @@index([reviewId])
  @@map("grading_results")
}

/// How one rubric line fared in this verdict. Written fresh by each
/// `GradingResult` and never shared between revisions — that is what makes an
/// override auditable line by line, not just in total.
model CriterionResult {
  id              String        @id @default(uuid()) @db.Uuid
  gradingResultId String        @db.Uuid
  gradingResult   GradingResult @relation(fields: [gradingResultId], references: [id], onDelete: Cascade)

  rubricCriterionId String          @db.Uuid
  rubricCriterion   RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Restrict)

  verdict CriterionVerdict
  /// Zero for MISS and for UNMARKED. They total the same and mean opposite
  /// things: a miss is "you did not earn this", an unmarked is "nobody has
  /// judged this yet", and only the second may not be shown as a loss.
  awarded Decimal @db.Decimal(5, 2)

  /// PARTIAL only: which rule fired, so the student is told *why* it is orange
  /// rather than just that it is.
  partialRuleId String?            @db.Uuid
  partialRule   PartialCreditRule? @relation(fields: [partialRuleId], references: [id], onDelete: SetNull)

  /// UNMARKED only: whether this is waiting on a human eye or a human signature.
  unmarkedReason UnmarkedReason?

  note String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  highlights HighlightSpan[]

  @@unique([gradingResultId, rubricCriterionId])
  @@index([verdict, unmarkedReason])
  @@index([partialRuleId])
  @@map("criterion_results")
}

/// A green/orange/red rectangle drawn over the student's own handwriting.
///
/// It hangs off the `GradingResult`, not off the `Answer`, for the same reason
/// the marks do: when a teacher overrides the AI, the teacher's highlights are
/// new rows and the AI's survive to be shown beside them.
///
/// The box is stored as fractions of the page (0–1), not pixels. The phone
/// decides the capture resolution and the viewer decides the zoom; a pixel box
/// is correct only for the single rendering it was measured in.
///
/// **An UNMARKED criterion produces no row here.** `color` is NOT NULL and has
/// exactly the three colours the product defines, rather than a nullable colour
/// or a fourth "none" member, because those both make the unsafe state
/// representable: every renderer, export and report would then have to remember
/// to skip it, and the one that forgets falls back to a default — which, for a
/// criterion that awarded nothing, is red. Red is the accusation the UNMARKED
/// outcome exists to prevent. A row that does not exist cannot be painted by
/// accident, and the `CriterionResult` still carries the verdict, so the
/// evaluator's checklist can show "diagram — needs your eye" with nothing drawn
/// over the student's handwriting.
model HighlightSpan {
  id              String        @id @default(uuid()) @db.Uuid
  gradingResultId String        @db.Uuid
  gradingResult   GradingResult @relation(fields: [gradingResultId], references: [id], onDelete: Cascade)

  /// Set when the span is the visual proof of one rubric line.
  criterionResultId String?          @db.Uuid
  criterionResult   CriterionResult? @relation(fields: [criterionResultId], references: [id], onDelete: Cascade)

  submissionPageId String         @db.Uuid
  submissionPage   SubmissionPage @relation(fields: [submissionPageId], references: [id], onDelete: Cascade)

  color HighlightColor

  /// Normalised page coordinates, top-left origin.
  x      Decimal @db.Decimal(6, 5)
  y      Decimal @db.Decimal(6, 5)
  width  Decimal @db.Decimal(6, 5)
  height Decimal @db.Decimal(6, 5)

  /// Half-open character range [start, end) in `Answer.transcript` that this box
  /// covers, when OCR produced one.
  transcriptStart Int?
  transcriptEnd   Int?

  /// Short reason shown on tap: "unit missing", "no formula stated".
  label String? @db.VarChar(200)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([gradingResultId])
  @@index([submissionPageId])
  @@index([criterionResultId])
  @@map("highlight_spans")
}

// ---------------------------------------------------------------------------
// Human review
// ---------------------------------------------------------------------------

/// The evaluator queue. One ticket per submission.
///
/// Claiming is a single conditional UPDATE against this table — no Redis, no
/// lock service. `status`, `claimedAt`, `claimedById` and `leaseExpiresAt` are
/// all part of that one statement; the exact SQL is in prisma/README.md.
model EvaluationTicket {
  id String @id @default(uuid()) @db.Uuid
  /// One ticket per submission. This unique is the idempotency guard for ticket
  /// creation, the way `idempotencyKey` is for the submission itself.
  submissionId String     @unique @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  subject  String @db.VarChar(60)
  classNum Int
  /// Higher is sooner. Paid tiers and near-SLA tickets get raised.
  priority Int    @default(0)

  status TicketStatus @default(PENDING)

  /// A preferred evaluator — a student's own school teacher. NULL means the
  /// ticket is open to anyone qualified.
  assignedEvaluatorId String? @db.Uuid
  assignedEvaluator   User?   @relation("TicketAssignedTo", fields: [assignedEvaluatorId], references: [id], onDelete: SetNull)

  claimedById String?   @db.Uuid
  claimedBy   User?     @relation("TicketClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt   DateTime? @db.Timestamptz(6)
  /// When an unfinished claim goes back on the queue. A sweeper resets any
  /// ticket past this, which is how a tutor who shuts their laptop mid-review
  /// resolves itself without a heartbeat service.
  leaseExpiresAt DateTime? @db.Timestamptz(6)
  /// How many times this ticket has been claimed. One claimed and dropped
  /// repeatedly is a bad scan, not a bad tutor.
  claimCount Int @default(0)

  slaDueAt    DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  reviews EvaluatorReview[]

  // Queue polling, in the order the claim statement reads them.
  @@index([status, priority(sort: Desc), createdAt])
  @@index([status, subject, classNum, priority(sort: Desc), createdAt])
  // The lease sweeper.
  @@index([status, leaseExpiresAt])
  // "My queue" and "tickets waiting for me".
  @@index([claimedById, status])
  @@index([assignedEvaluatorId, status])
  @@map("evaluation_tickets")
}

/// One evaluator's pass over a ticket. Separate from the ticket because a
/// ticket can be claimed, abandoned and re-claimed, and each pass is its own
/// record of who looked at what, and for how long.
model EvaluatorReview {
  id       String           @id @default(uuid()) @db.Uuid
  ticketId String           @db.Uuid
  ticket   EvaluationTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  evaluatorId String @db.Uuid
  evaluator   User   @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  startedAt   DateTime  @default(now()) @db.Timestamptz(6)
  submittedAt DateTime? @db.Timestamptz(6)
  /// NULL until submitted, then true if every AI mark was left standing. The
  /// per-answer truth is in `GradingResult`; this is the cheap rollup used to
  /// measure the model.
  agreedWithAi Boolean?
  notes        String?
  timeSpentSec Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  gradingResults GradingResult[]
  voiceNotes     VoiceNote[]

  @@index([ticketId, startedAt])
  @@index([evaluatorId, submittedAt(sort: Desc)])
  @@map("evaluator_reviews")
}

/// A spoken note on one answer, up to 90 seconds.
///
/// The foreign key is to `Answer`, not to the ticket: the product promises a
/// voice note per question, and a single recording hanging off the whole script
/// cannot be played beside question 27.
model VoiceNote {
  id       String @id @default(uuid()) @db.Uuid
  answerId String @db.Uuid
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  /// The review it was recorded during. NULL if recorded outside one.
  reviewId String?          @db.Uuid
  review   EvaluatorReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  evaluatorId String @db.Uuid
  evaluator   User   @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  /// Object key, not a URL — see `SubmissionPage.storageKey`.
  storageKey String @db.VarChar(512)
  mimeType   String @db.VarChar(64)
  /// Capped at 90_000 by a CHECK constraint added in the migration; Prisma
  /// cannot express it. See prisma/README.md.
  durationMs Int
  bytes      Int?

  transcript String?
  /// BCP-47 tag of the transcript, which may differ from the spoken language.
  transcriptLang   String?          @db.VarChar(16)
  transcriptStatus TranscriptStatus @default(PENDING)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([answerId, createdAt])
  @@index([reviewId])
  @@index([transcriptStatus, createdAt])
  @@map("voice_notes")
}
