# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committable; `.env*` swallows it otherwise.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/ncert-original/
public/ncert/
data/prelims/
public/papers/
data/curriculum/
public/pyqs/
public/exemplar/

# Mirrored third-party PDFs. Never committed: they are someone else's
# copyright, they are large, and every one is regenerable from scripts/.
# public/papers/ (what the app serves) was already ignored; data/cbse/ holds
# the same CBSE papers and marking schemes as fetched, so it belongs here too.
# Restore with: npm run content:papers
data/cbse/

# Scratch scripts kept out of the pipeline proper.
scripts/.tmp/

# Local dev object storage (the S3 driver's stand-in). Scans and voice notes.
/.storage/
